{
  "name": "@kuma/webcomponents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./button": {
      "types": "./src/kuma-button.ts",
      "development": "./src/kuma-button.ts",
      "import": "./dist/kuma-button.js",
      "default": "./dist/kuma-button.js"
    },
    "./money-card": {
      "types": "./src/kuma-money-card.ts",
      "development": "./src/kuma-money-card.ts",
      "import": "./dist/kuma-money-card.js",
      "default": "./dist/kuma-money-card.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
